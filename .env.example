# Twitch live status (Phase 3). Client-credentials app token.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_USER_LOGIN=memesandmarkets

# Force the player into its live state for demos, and as a fallback if Twitch is down.
FORCE_LIVE=false

# Substack newsletter. lib/newsletter.ts defaults to
# https://memesandmarketspod.substack.com — the publication's own address, which
# a DNS change cannot take away. Set this only if the publication moves again.
#
# THE PUBLICATION IS STILL UNREACHABLE AND NEITHER VARIABLE CAN FIX IT. It has
# www.memesandmarkets.com set as an ENFORCED custom domain
# (custom_domain_optional: false) and the site now owns that domain, so the
# subdomain 301s back here: the feed lands on a Next 404, and a signup POST is
# downgraded to a GET and lands on the same. Release the domain in
# Substack > Settings > Domain first. Nothing reaches Substack until you do.
SUBSTACK_PUBLICATION_URL=

# The same address again, for the browser. The signup POST happens in the
# visitor's browser (Substack refuses every server), so the value has to be
# inlined into the client bundle at build time, which is what NEXT_PUBLIC_ does.
# Two variables rather than a rename because the server one is already set in
# Vercel. Leave both blank unless the publication actually moves.
NEXT_PUBLIC_SUBSTACK_PUBLICATION_URL=

# The audience numbers on the landing page. WITHOUT THIS THEY DO NOT UPDATE:
# lib/stats.ts serves content/channel-stats-fallback.json instead, which is real
# but frozen at whenever it was last committed. Free and read-only — enable
# "YouTube Data API v3" at console.cloud.google.com and create an API key.
# Restrict it to that one API; it needs no other scope and no OAuth.
YOUTUBE_API_KEY=

# The Google Sheet, in both directions. ONE Apps Script deployment carries all of
# it: partnership enquiries and job applications are posted to it, and /careers
# reads the roles listing back out of it. See scripts/sheet-webhook.gs for the
# ten-minute setup; the /exec URL it gives you goes here.
#
# Without it /api/partner and /api/careers answer 503 and tell people to email
# instead, rather than pretending to file something nobody will read — and
# /careers renders from content/roles-fallback.json, which ships empty, so it
# honestly says nothing is open. All three are normal states for a fresh clone.
#
# The newsletter does NOT use this, and needs no endpoint of its own: the signup
# posts straight from the browser to Substack. See lib/newsletter.ts for why no
# server of ours is allowed to make that call.
SHEET_WEBHOOK=
# Must match SHARED_SECRET inside the Apps Script. The web app has to be open to
# "Anyone" for Vercel to reach it, so this is what stops a leaked URL becoming a
# spam funnel into the sheet — and, now that CVs go through it, into the Drive
# folder, which matters rather more.
SHEET_SECRET=
#
# PARTNER_SHEET_WEBHOOK and PARTNER_SHEET_SECRET are the older names for those
# two and are still read as fallbacks, so an existing deployment keeps working
# without anybody standing in the Vercel dashboard at the same moment.
# lib/sheet.ts is the only place that knows about the aliasing; new deployments
# should set the SHEET_ names and leave the old ones alone.
#
# The Drive folder id the CVs are saved into is deliberately NOT here. It lives
# inside the Apps Script, because the site never touches Drive and putting the id
# in Vercel would imply that it does.

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. NEXT_PUBLIC_ because the
# tag runs in the browser; it is not a secret — anyone can read it in the page
# source of any site using GA. Without it, neither the analytics script NOR the
# cookie banner renders: the banner asks specifically about Google Analytics, and
# with no id there is nothing to ask about. Leave it unset until you want data.
NEXT_PUBLIC_GA_ID=

# Google Search Console, meta-tag verification. OPTIONAL — a working token for
# www.memesandmarkets.com is committed in app/layout.tsx, because it is public in
# the page source anyway and verification should survive a missing variable. Set
# this only to override it. Only the token from the "HTML tag" method — the bare
# content value, not the whole <meta> element.
# The DNS TXT method needs nothing here and survives a change of host, so prefer
# it if the domain is yours to edit.
NEXT_PUBLIC_GSC_VERIFICATION=
